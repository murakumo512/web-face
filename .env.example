PORT=5001
# Ganti dengan URI MongoDB lokal atau MongoDB Atlas Anda
MONGODB_URI=mongodb://127.0.0.1:27017/presensi_wajah
# Jika true, aplikasi otomatis memakai embedded MongoDB (mongodb-memory-server) saat MongoDB lokal tidak aktif
ALLOW_EMBEDDED_MONGO_FALLBACK=true
# Ambang jarak Euclidean untuk kecocokan wajah (lebih kecil = lebih ketat, rekomendasi 0.48 - 0.55)
FACE_MATCH_THRESHOLD=0.52
